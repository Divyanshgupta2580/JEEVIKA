{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jeevika-api",
  "main": "backend/src/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dhaaga-db",
      "database_id": "d5d65397-2840-4926-b811-ac534fade5f1",
      "migrations_dir": ".local/integration-migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "b7197004e5324cc0a843ad0f276eaabd"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CLINIC_INVENTORY",
        "class_name": "ClinicInventory"
      },
      {
        "name": "CLINIC_HUB",
        "class_name": "ClinicHub"
      },
      {
        "name": "TRIAGE_SESSION",
        "class_name": "TriageSession"
      },
      {
        "name": "ORG_AUDIT",
        "class_name": "OrgAudit"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ClinicInventory",
        "ClinicHub",
        "TriageSession",
        "OrgAudit"
      ]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "DEMO_MODE": "true",
    "PUBLIC_ORIGIN": "https://jeevika-beta.vercel.app",
    "API_VERSION": "v1"
  }
}
