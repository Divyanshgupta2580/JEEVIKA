{
  "buildCommand": "npm run integration:build",
  "outputDirectory": "dist/integration",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://jeevika-api.workers.dev/api/v1/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://jeevika-api.workers.dev/healthz"
    },
    {
      "source": "/((?!assets/|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self)" }
      ]
    }
  ]
}
